# Modèle de configuration. Copier ce fichier en ".env" puis remplacer les valeurs.
# Le fichier ".env" ne doit JAMAIS être versionné. Voir README.md et SECURITY.md.

# --- Utilisateur unique du site (hash BCrypt, jamais le mot de passe en clair) ---
# Générer le hash : voir README.md, section « Créer l'utilisateur »
BFF_USERNAME=<votre-identifiant>
BFF_PASSWORD_HASH=<hash-bcrypt>

# --- my-scan-doc-api et son compte de service ---
API_BASE_URL=https://my-scan-doc-api.onrender.com
API_SERVICE_USERNAME=<compte-de-service-de-l-api>
API_SERVICE_PASSWORD=<mot-de-passe-du-compte-de-service>

# --- Divers ---
# Cookie de session réservé à HTTPS (true par défaut). Mettre false uniquement en local sans HTTPS.
# BFF_COOKIE_SECURE=false
# Port d'écoute (8080 par défaut ; l'API locale utilise déjà 8080)
# PORT=8081
